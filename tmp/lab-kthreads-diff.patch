+int
+clone(struct proc * p, uint64 fn, uint64 arg1, uint64 arg2, uint64 stack)
+{
+  int i, pid;
+  struct proc *np;
+
+  // Allocate process.
+  if((np = allocproc(0)) == 0){
+    return -1;
+  }
+
+  np->shared = p->shared;
+  p->shared->count++;
+  // copy saved user registers.
+  *(np->trapframe) = *(p->trapframe);
+
+  // Cause fork to return 0 in the child.f
+  np->trapframe->a0 = arg1;
+  np->trapframe->a1 = arg2;
+  np->trapframe->epc = fn;
+  np->trapframe->sp = stack + PGSIZE;
+
+  for (int i = 1; i < NPROC; i++) {
+    if (np->shared->ts[i] == AVAILABLE) {
+      np->shared->ts[i] = UNAVAILABLE;
+      np->threadID = i;
+      break;
+    }
+  }
+
+  // acquire(&p->shared->lock);
+  uint64 trapframeAddress = (uint64) GET_TRAPFRAME(np->threadID);
+  if (is_valid_va(p->shared->pagetable, trapframeAddress)) {
+    uvmunmap(p->shared->pagetable, trapframeAddress, 1, 0);
+  }
+
+  if (mappages(p->shared->pagetable, trapframeAddress, PGSIZE, (uint64)(np->trapframe), PTE_R | PTE_W) < 0) {
+    freeproc(np);
+    release(&np->lock);
+    // release(&p->shared->lock);
+    return -1;
+  }
+  // release(&p->shared->lock);
+
+  // increment reference counts on open file descriptors.
+  for(i = 0; i < NOFILE; i++)
+    if(p->ofile[i])
+      np->ofile[i] = filedup(p->ofile[i]);
+  np->cwd = idup(p->cwd);
+
+  safestrcpy(np->name, p->name, sizeof(p->name));
+
+  pid = np->pid;
+
+  release(&np->lock);
+
+  acquire(&wait_lock);
+  np->parent = p;
+  release(&wait_lock);
+
+  acquire(&np->lock);
+  np->state = RUNNABLE;
+  release(&np->lock);
+
+  return pid;
+}
+
+int
+join(struct proc * p, uint64 userStack, uint64 userRetVal)
+{
+  struct proc *np;
+  int havekids;
+
+  acquire(&wait_lock);
+
+  for(;;){
+    // Scan through table looking for exited children.
+    havekids = 0;
+    for(np = proc; np < &proc[NPROC]; np++){
+      if(np->parent == p && np->threadID > 0){
+        // make sure the child isn't still in exit() or swtch().
+        acquire(&np->lock);
+
+        havekids = 1;
+        if(np->state == ZOMBIE){
+          acquire(&np->shared->lock);
+          // found a valid thread
+
+          uint64 retval = np->xstate;
+          uint64 stack = PGROUNDDOWN(np->trapframe->sp);
+
+          if (userStack > stack && userStack < PGROUNDUP(stack)) {
+            release(&wait_lock);
+            release(&np->lock);
+            release(&np->shared->lock);
+            return -1;
+          }
+
+          if (copyout(p->shared->pagetable, userStack, (char *) &stack, sizeof(uint64)) < 0) {
+            release(&wait_lock);
+            release(&np->lock);
+            release(&np->shared->lock);
+            return -1;
+          }
+
+          if (userRetVal && copyout(p->shared->pagetable, userRetVal, (char *) &retval, sizeof(uint32)) < 0) {
+            release(&wait_lock);
+            release(&np->lock);
+            release(&np->shared->lock);
+            return -1;
+          }
+
+          int pid = np->pid;
+          release(&np->shared->lock);
+          freeproc(np);
+          release(&wait_lock);
+          release(&np->lock);
+          return pid;
+        }
+        release(&np->lock);
+      }
+    }
+
+    // No point waiting if we don't have any children.
+    if(!havekids || p->killed){
+      release(&wait_lock);
+      return -1;
+    }
+    
+    // Wait for a child to exit.
+    sleep(p, &wait_lock);  //DOC: wait-sleep
+  }
+
+  return -1;
+}
