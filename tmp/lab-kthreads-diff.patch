+uint64
+sys_clone(void)
+{
+  uint64 fn_ptr;
+  uint64 arg1;
+  uint64 arg2;
+  uint64 stack_ptr;
+
+  if (argaddr(0, &fn_ptr) < 0)
+    return -1;
+  if (argaddr(1, &arg1) < 0)
+    return -1;
+  if (argaddr(2, &arg2) < 0)
+    return -1;
+  if (argaddr(3, &stack_ptr) < 0)
+    return -1;
+
+  struct proc * p = myproc();
+  acquire(&p->shared->lock);
+  if (stack_ptr % PGSIZE != 0 || !is_valid_va(p->shared->pagetable, stack_ptr) || stack_ptr == 0 || !is_valid_va(p->shared->pagetable, fn_ptr)) {
+    release(&p->shared->lock);
+    return -1;
+  }
+  release(&p->shared->lock);
+
+  return clone(p, fn_ptr, arg1, arg2, stack_ptr);
+}
+
+uint64
+sys_join(void)
+{
+  uint64 stack;
+  uint64 retval;
+
+  struct proc * p = myproc();
+
+  acquire(&p->shared->lock);
+  if (argaddr(0, &stack) < 0 || !is_valid_va(p->shared->pagetable, stack)) {
+    release(&p->shared->lock);
+    return -1;
+  }
+  release(&p->shared->lock);
+
+  if (argaddr(1, &retval) < 0)
+    return -1;
+
+  return join(p, stack, retval);
+}
