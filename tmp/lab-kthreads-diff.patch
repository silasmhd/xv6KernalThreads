+// Helper to check if a user virtual address is mapped
+int is_valid_va(pagetable_t pagetable, uint64 va) {
+  pte_t * pte = 0;
+  if (va >= MAXVA) {
+    return 0;
+  }
+
+  if ((pte = walk(pagetable, va, 0)) == 0) {
+    return 0;
+  }
+
+  return (*pte & PTE_V);
+}
