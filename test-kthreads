#!/usr/bin/env python3

import re
from testlib import *

r = Runner(save("xv6.out"))

@test(1, "BasicCloneWorks")
def test_basicclone():
    r.run_qemu(shell_script([
        'clone_basic'
    ]))
    r.match(no=["usertrap"])
    r.match(no=["kerneltrap"])
    r.match("^PASSED TEST!", no=[".*usertrap.*", ".*kerneltrap.*"]);

